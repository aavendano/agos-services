# Core Django Settings
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
DATABASE_URL=postgres://paperclip_user:password@localhost:5432/paperclip_db

# Redis / Cache Configuration
REDIS_URL=redis://localhost:6379/0

# Shopify Custom App Credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-07
SHOPIFY_REDIRECT_URI=https://your-domain.com/api/auth/shopify/callback/
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,write_inventory

# MCP Gateway Configuration
MCP_SERVER_NAME=hi-bel-shopify-mcp
MCP_SERVER_VERSION=0.1.0
MCP_AUTH_REQUIRED=True
